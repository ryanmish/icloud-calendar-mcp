# Personal deployment. Copy to .env.personal; no secret values go here.
MCP_PUBLIC_URL=https://cal.ryanmish.com
MCP_LOGIN_METHOD=password
# Optional: match the protected host files to a non-root container user.
# CALENDAR_UID=1000
# CALENDAR_GID=1000
MCP_OAUTH_ISSUER=https://cal.ryanmish.com/api/auth
MCP_OAUTH_JWKS_URL=https://cal.ryanmish.com/api/auth/jwks
# Prefill only. Use the real iCloud address, not the Apple relay email.
# Leave empty to use the address you enter during owner signup as a prefill.
ICLOUD_USERNAME=
# Optional Apple login only: set MCP_LOGIN_METHOD=apple and these values.
# APPLE_CLIENT_ID=replace-with-apple-services-id
# APPLE_TEAM_ID=replace-with-team-id
# APPLE_KEY_ID=replace-with-key-id
# Upper limits for the owner setup page and every MCP call.
MCP_READ_CALENDARS=["*"]
MCP_WRITE_CALENDARS=[]
MCP_WRITE_OPERATIONS=[]
