# Non-secret configuration. Copy this file to .env only when setting up a host.
MCP_PUBLIC_URL=https://calendar-mcp.example.com
# Keep the exact issuer spelling and trailing slash from its discovery document.
MCP_OAUTH_ISSUER=https://auth.example.com/realms/calendar
MCP_OAUTH_JWKS_URL=https://auth.example.com/realms/calendar/protocol/openid-connect/certs
MCP_OWNER_SUBJECT=replace-with-the-permitted-user-subject
ICLOUD_USERNAME=replace-with-apple-account-email
ICLOUD_PASSWORD_FILE=/run/secrets/icloud_app_password
# Start with read access. Use list_calendars to find the exact calendar IDs.
# ["*"] permits reads from all account calendars; exact IDs are preferred.
MCP_READ_CALENDARS=["*"]
# To enable writes, set exact calendar IDs and the desired operations:
# MCP_WRITE_CALENDARS=["replace-with-calendar-id"]
# MCP_WRITE_OPERATIONS=["create","update"]
MCP_WRITE_CALENDARS=[]
MCP_WRITE_OPERATIONS=[]
